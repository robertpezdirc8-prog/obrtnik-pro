# ─── Vzorčna nastavitev okolja ────────────────────────────────
# Kopiraj v .env in po potrebi prilagodi:  cp .env.example .env
# `.env` je NEVZPOSTAVLJEN v repozitoriju (glej .gitignore) — v njem
# naj bodo samo lokalne poti, nikoli skrivnosti.

# SQLite baza (ustvari se z `bun run db:push`).
# POZOR: Prisma razreši relativno `file:` pot glede na mapo prisma/,
# zato `../db/custom.db` pomeni <koren projekta>/db/custom.db —
# ista pot, ki jo pričakuje .gitignore (`/db`).
DATABASE_URL="file:../db/custom.db"

# ─── Avtentikacija (Task 93, issue #2) ───────────────────────
# Skrivnost za podpis sejnih piškotkov (najmanj 32 znakov). Ustvari:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Če je prazna, se uporabi začasna skrivnost procesa — seje NE
# preživijo ponovnega zagona (glasno opozorjeno v logu ob prvi uporabi).
AUTH_SECRET=""

# '1' = API zahteva prijavo (prijavni zaslon je aktiven).
# prazno ali '0' = odprto — lokalni razvoj, E2E preverbe in tablica
# tečejo kot prej. Uveljavljanje je odločitev namestitve, ne kode
# (kultura projekta: zavestno in zapisano, ne skrito).
AUTH_ENFORCED=0
