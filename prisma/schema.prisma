generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Katalog ────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String    @default("hammer")
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  unit        String      @default("kos")
  unitPrice   Float
  sku         String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  offerItems  OfferItem[]
}

// ─── Ponudbe ────────────────────────────────────────────────

model Offer {
  id              String      @id @default(cuid())
  number          String      @unique
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  objectAddress   String?
  note            String?
  status          String      @default("draft")
  subtotal        Float
  vatRate         Float       @default(22)
  vatAmount       Float
  total           Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OfferItem[]
  invoices        Invoice[]
}

// ─── Računi (iz sprejete ponudbe) ───────────────────────

model Invoice {
  id           String   @id @default(cuid())
  number       String   @unique
  offerId      String
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerName String
  subtotal     Float
  vatRate      Float
  vatAmount    Float
  total        Float
  createdAt    DateTime @default(now())
}

model OfferItem {
  id          String   @id @default(cuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  description String?
  quantity    Float
  unit        String
  unitPrice   Float
  total       Float
  sortOrder   Int      @default(0)
}

// ─── Nastavitve podjetja ────────────────────────────────────

// ─── Pametna kamera ─────────────────────────────────────────

model Photo {
  id           String   @id @default(cuid())
  title        String?
  craftId      String?
  dataUrl      String
  analysis     String?
  measurements String?
  createdAt    DateTime @default(now())
}

model Settings {
  id              String  @id @default("default")
  companyName     String  @default("Moj Obrt s.p.")
  ownerName       String  @default("")
  address         String  @default("")
  phone           String  @default("")
  email           String  @default("")
  taxNumber       String  @default("")
  iban            String  @default("")
  vatRate         Float   @default(22)
  laborRate       Float   @default(35)
  quoteValidDays  Int     @default(15)
  depositPercent  Float   @default(30)
  paymentDays     Int     @default(15)
  logoUrl         String?
}
