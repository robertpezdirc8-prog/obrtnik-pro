generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Uporabniki (Task 93 — issue #2) ────────────────────────
// Aplikacija je namenjena enemu obratu: prvi ustvarjeni račun je
// lastnik, registracija se po njem ZAPRE (glej /api/auth/register).
// Koliko montirjev in kakšne pravice, je prihodnja odločitev
// lastnika — zato tu še ni vlog drug kot `owner`.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  /// Format "scrypt$saltB64$hashB64" (N=2^14, r=8, p=1, 32 B) —
  /// glej src/lib/auth.ts. Nikoli v odgovorih API.
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
}

// ─── Katalog ────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String    @default("hammer")
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  unit        String      @default("kos")
  /// Cena v katalogu NI: katalog pove, KAJ je (naziv, mera, enota), ceno pa
  /// vedno vpiše obrtnik v Ceniku (Task 88 — `CenikPrice`). Prejšnja različica
  /// je imela tu 50 izmišljenih številk, ki so tekle po ponudbah.
  sku         String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  offerItems  OfferItem[]
}

// ─── Cenik (edini vir denarja) ──────────────────────────────
//
// Ključ je `PriceKey` iz `src/lib/cenik.ts` — register, ki ve, KAJ je mogoče
// oceniti. `unitPrice` je null, dokler obrtnik cene ni vpisal: prazno polje ni
// ničla in ni prejšnja vrednost. Iz teh vrstic pride denar v ponudbo samo
// prek `applyCenik` (`src/lib/cenik.ts`), nikoli iz kode.

model CenikPrice {
  key       String   @id
  unitPrice Float?
  updatedAt DateTime @updatedAt
}

// ─── Ponudbe ────────────────────────────────────────────────

model Offer {
  id              String      @id @default(cuid())
  number          String      @unique
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String?
  objectAddress   String?
  note            String?
  status          String      @default("draft")
  /// Kdaj je ponudba označena za poslano (časovni žig za iskren win-rate).
  sentAt          DateTime?
  /// Kdaj je stranka odločila (sprejeto/zavrnjeno) — izhodišče konverzije.
  decidedAt       DateTime?
  /// Wiedervorlage — datum, ko obrtnik sam sebi zastavi opomnik za follow-up.
  followUpAt      DateTime?
  subtotal        Float
  /// DDV je PODATK NA dokumentu, ne privzetek aplikacije: ob ustvarjanju
  /// ponudbe ga piše pot, ki je prebrala Nastavitve. `@default(22)` je bil
  /// izmišljena davčna odločitev.
  vatRate         Float
  vatAmount       Float
  total           Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OfferItem[]
  invoices        Invoice[]
  timeEntries     TimeEntry[]
  diaryEntries    DiaryEntry[]
}

// ─── Računi (iz sprejete ponudbe) ───────────────────────

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  offerId      String
  offer        Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerName String
  subtotal     Float
  vatRate      Float
  vatAmount    Float
  total        Float
  /// Rok plačila — null pomeni privzeti rok 30 dni od izdaje (izračuna knjižnica).
  dueAt        DateTime?
  /// Kdaj je račun plačan — null = neplačan (izhodišče za terjatve + Mahnwesen).
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  /// Snapshot postavk ob izdaji — e-račun (EN 16931) zahteva vsaj eno vrstico (BR-16).
  items        InvoiceItem[]
}

// ─── Postavke računa (snapshot iz ponudbe ob izdaji) ────
// Raziskava 2026 (ZIERDED — Državni zbor 23. 11. 2025): B2B e-račun
// (e-SLOG / EN 16931, UBL 2.1) obvezen od 1. 1. 2028, za javni sektor
// že zdaj prek UJP. Račun MORA imeti vrstice (BR-16) — zato se ob
// izdaji računa postavke ponudbe ZAPIEJEJO tu (pravi snapshot:
// poznejše spremembe ponudbe ne prepišejo zgodovine računa).

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float
  unit        String
  unitPrice   Float
  total       Float
  sortOrder   Int     @default(0)
}

model OfferItem {
  id          String   @id @default(cuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  description String?
  quantity    Float
  unit        String
  unitPrice   Float
  total       Float
  sortOrder   Int      @default(0)
}

// ─── Nastavitve podjetja ────────────────────────────────────

// ─── Pametna kamera ─────────────────────────────────────────

model Photo {
  id           String   @id @default(cuid())
  title        String?
  craftId      String?
  dataUrl      String
  analysis     String?
  measurements String?
  vizState     String?
  createdAt    DateTime @default(now())
}

model Settings {
  id              String  @id @default("default")
  companyName     String  @default("Moj Obrt s.p.")
  ownerName       String  @default("")
  address         String  @default("")
  phone           String  @default("")
  email           String  @default("")
  taxNumber       String  @default("")
  iban            String  @default("")
  /// DENAR IN ROKI BREZ PRIVZETKOV. `@default(22)`, `@default(35)` in
  /// `@default(30)` so aplikacijo zagnala s številkami, ki jih obrtnik ni
  /// vpisal — prazna vrednost je zato null, `readSettings` jo javi kot
  /// »številka ni vpisana« in dokument vrsto izpusti z razlogom (Task 86, 88).
  vatRate         Float?
  laborRate       Float?
  quoteValidDays  Int?
  depositPercent  Float?
  paymentDays     Int?
  logoUrl         String?
}

// ─── Časovnica (Zeiterfassung) ──────────────────────────────

model TimeEntry {
  id           String    @id @default(cuid())
  /// Delovni dan "YYYY-MM-DD" (niz brez časovnih pasov — iskreno in deterministično).
  day          String
  /// Opis opravila (npr. "Montaža ograje — balkon").
  description  String
  /// Oddelane minute (celo število ≥ 1).
  minutes      Int
  /// Urna postavka v času vnosa (€/h) — kasnejše spremembe nastavitev ne prepišejo zgodovine.
  hourlyRate   Float
  /// Stranka (iz ponudbe ali prosti vnos).
  customerName String?
  /// Povezava na ponudbo (opcijsko).
  offerId      String?
  offer        Offer?    @relation(fields: [offerId], references: [id])
  /// Dejavnost (craftId ali null za "drugo").
  craftId      String?
  /// Kdaj je vnos označen kot obračunan (žig nastavlja strežnik prek PATCH).
  billedAt     DateTime?
  /// Referenca obračuna (št. ponudbe ali kratek opis).
  billedRef    String?
  createdAt    DateTime  @default(now())
}

// ─── Terenski dnevnik (Baustellendokumentation) ────────────
// Raziskava 2026 (qonto top-11, fuer-gruender 13: baustellendoku)
// dokazuje: zapisi z datumom + fotke so dokaz izvedenega dela
// (spori, garancija, Wandelanträge). Vnosi so vezani na dan,
// ne na točen čas — na objektu se zapisuje po opravljenem delu.

model DiaryEntry {
  id        String   @id @default(cuid())
  /// Delovni dan "YYYY-MM-DD" (niz brez časovnih pasov — kot pri časovnici).
  day       String
  /// Faza dela: priprava / demontaza / montaza / zakljucek / ostalo.
  phase     String   @default("ostalo")
  /// Opis opravljenega dela (0–500 znakov).
  note      String
  /// Povezava na ponudbo (opcijsko — ure se pošteva po nalogu).
  offerId   String?
  offer     Offer?   @relation(fields: [offerId], references: [id])
  /// Prosta oznaka objekta, kadar vnos ni vezan na ponudbo.
  objectLabel String?
  /// Fotografije: JSON niz [{ dataUrl, thumb, caption }].
  photos    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
